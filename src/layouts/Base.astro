---
import "@fontsource-variable/rokkitt";
import "@fontsource/lato/400.css";
import "@fontsource/lato/700.css";
import "../styles/global.css";
import { site } from "../config";
const { title, description = "A Bible-based church planting, clean water, children's home, restoration and skills ministry transforming lives around the world." } = Astro.props;
const path = Astro.url.pathname;
const nav = [["/","Home"],["/about","About"],["/beliefs","Beliefs"],["/ministries","Ministries"],["/#books","Books"],["/contact","Contact"],["/give","Give"]];
---
<html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
<title>{title} | {site.name}</title><meta name="description" content={description}/><meta name="theme-color" content="#8c6d4b"/><link rel="icon" href="/favicon.svg" type="image/svg+xml"/>
<script is:inline>document.documentElement.classList.add("js")</script></head>
<body>
<a class="skip" href="#main">Skip to content</a>
<div class="prog" id="prog" aria-hidden="true"></div>
<header class="top" id="top"><div class="wrap">
  <div class="logo"><a href="/" class="brand"><img class="mark" src="/logo-mark.svg" alt="" width="96" height="92"/><span class="bn">{site.name}</span></a></div>
  <input type="checkbox" id="nav-t" class="nav-t" aria-label="Menu"/><label for="nav-t" class="burger" aria-hidden="true"><i></i></label>
  <nav>{nav.map(([h,l]) => <a href={h} class:list={[{on: h==="/"? path==="/" : path.startsWith(h)}, {pill: h==="/give"}]}>{l}</a>)}</nav>
</div></header>
<main id="main"><slot/></main>
<footer><div class="wrap fgrid">
  <div><p class="fname">{site.name}</p><p>Five pillars of evangelism. One gospel.</p></div>
  <div><p class="fh">Contact</p><p><a href={`tel:${site.phone}`}>{site.phone}</a><br/><a href={`https://wa.me/${site.whatsapp}`}>WhatsApp us</a></p></div>
  <div><p class="fh">Give by M-Pesa</p><p>Paybill {site.paybill.number}<br/>Account {site.paybill.account}</p></div>
</div><p class="wrap copy">© {new Date().getFullYear()} {site.name}</p></footer>
<script is:inline>
(()=>{
const d=document,root=d.documentElement,top=d.getElementById("top"),navT=d.getElementById("nav-t"),bar=d.getElementById("prog");
const rm=matchMedia("(prefers-reduced-motion:reduce)").matches;
const hero=d.querySelector(".hero");
let last=scrollY,queued=false;

/* one rAF-throttled scroll handler: solid header, hide/show header, progress line, hero parallax */
function frame(){
  queued=false;const y=scrollY,max=root.scrollHeight-innerHeight;
  top.classList.toggle("solid",y>40);
  if(bar)bar.style.transform="scaleX("+(max>0?Math.min(Math.max(y/max,0),1):0)+")";
  if(rm)return;
  if(y<=480){top.classList.remove("hide");last=y}
  else if(y-last>6&&!(navT&&navT.checked)){top.classList.add("hide");last=y}
  else if(last-y>6){top.classList.remove("hide");last=y}
  if(hero&&y<innerHeight*1.3){
    const p=Math.min(y/(hero.offsetHeight*.65),1);
    hero.style.setProperty("--py",(y*.3).toFixed(1)+"px");
    hero.style.setProperty("--hy",(y*.12).toFixed(1)+"px");
    hero.style.setProperty("--hf",(1-p).toFixed(3));
  }
}
const on=()=>{if(!queued){queued=true;requestAnimationFrame(frame)}};
frame();addEventListener("scroll",on,{passive:true});addEventListener("resize",on);
top.addEventListener("focusin",()=>top.classList.remove("hide"));

/* reveal on scroll */
if(rm||!("IntersectionObserver" in window))return;
const targets=[".visit .wrap > *",".gallery > *",".intro h2",".pillar .ptext",".pillar .pimg",
 ".band .wrap > :not(.partners)",".partners li",".books h2",".bk-lede",".bk",".split > *",
 ".prose > *",".sh",".staff li",".m .mt",".mimg",".vm > *",".bel article",".give .gbox",".fgrid > *"];
const els=[...d.querySelectorAll(targets.join(","))];
try{
  els.forEach(e=>e.setAttribute("data-reveal",e.matches(".pimg,.mimg,.gallery > *")?"img":"fade"));
  const io=new IntersectionObserver(entries=>{
    /* items that arrive together are staggered in reading order */
    const seen=entries.filter(e=>e.isIntersecting).sort((a,b)=>{
      const A=a.boundingClientRect,B=b.boundingClientRect;
      return Math.round(A.top/60)-Math.round(B.top/60)||A.left-B.left});
    seen.forEach((e,i)=>{
      const t=e.target,delay=Math.min(i,6)*.09;io.unobserve(t);
      t.style.setProperty("--d",delay+"s");
      requestAnimationFrame(()=>t.classList.add("in"));
      setTimeout(()=>{t.removeAttribute("data-reveal");t.classList.remove("in");t.style.removeProperty("--d")},(delay+1.8)*1000);
    });
    /* anything already scrolled past (e.g. reloaded mid-page) just shows */
    entries.forEach(e=>{if(!e.isIntersecting&&e.boundingClientRect.bottom<0){io.unobserve(e.target);e.target.removeAttribute("data-reveal")}});
  },{threshold:0,rootMargin:"0px 0px -4% 0px"});
  els.forEach(e=>io.observe(e));
  /* failsafe: never leave anything on screen hidden */
  const show=()=>els.forEach(e=>{if(e.hasAttribute("data-reveal")){const r=e.getBoundingClientRect();if(r.top<innerHeight&&r.bottom>0){io.unobserve(e);e.removeAttribute("data-reveal")}}});
  setTimeout(show,2500);addEventListener("load",()=>setTimeout(show,1500));
}catch(err){els.forEach(e=>e.removeAttribute("data-reveal"))}
})();
</script>
</body></html>
