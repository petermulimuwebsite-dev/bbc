---
import fs from "node:fs"; import path from "node:path";
const { src, poster = "", class: cls = "" } = Astro.props;
const found = fs.existsSync(path.join(process.cwd(), "public/videos", src));
const hasPoster = poster && fs.existsSync(path.join(process.cwd(), "public/images", poster));
---
{found && <video class={cls} autoplay muted loop playsinline preload="metadata" poster={hasPoster ? `/images/${poster}` : undefined} aria-hidden="true"><source src={`/videos/${src}`} type="video/mp4"/></video>}
