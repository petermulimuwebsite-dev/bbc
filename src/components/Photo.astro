---
import { hasImg, imgUrl } from "../img";
// Renders nothing when the file is missing from public/img, so there is never an empty image box.
const { src, alt = "", class: cls = "", pos = "" } = Astro.props;
---
{hasImg(src) && <img src={imgUrl(src)} alt={alt} loading="lazy" decoding="async" class={cls} style={pos ? `object-position:${pos}` : undefined} />}
