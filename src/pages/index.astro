---
import Base from "../layouts/Base.astro"; import Photo from "../components/Photo.astro"; import ContactForm from "../components/ContactForm.astro"; import { hasImg } from "../img"; import { site, books, bookInfo } from "../config";
const pillars = [
 ["Church planting and evangelism","Vibrant, locally led congregations with Bible-based leadership that preach the gospel and disciple believers.","/ministries#church-planting","Lawrance performing Baptist.jpg","50% 40%"],
 ["Jacob’s Well clean water project","Solar-powered boreholes and purification, with a disciple ready to share the living water of John 4.","/ministries#water","water drilling.jpg","50% 50%"],
 ["Nuru Toto children’s home","A safe, loving home for 30 children of the light: housing, meals, healthcare, school and the Word every day.","/ministries#nuru-toto","children 1.jpg","50% 50%"],
 ["Renewed Hearts Association","Pastoral counseling and recovery for people facing addiction, divorce and hardship.","/ministries#renewed-hearts","",""],
 ["Hybells Christian School","A technical school teaching market-ready skills such as welding, masonry, fashion design and video editing, with compulsory Bible courses and leadership development.","/ministries#hybells","",""],
];
