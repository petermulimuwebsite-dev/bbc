---
import Base from "../layouts/Base.astro"; import Photo from "../components/Photo.astro"; import Video from "../components/Video.astro"; import ContactForm from "../components/ContactForm.astro"; import { site } from "../config";
const pillars = [
 ["Church planting and evangelism","Vibrant, locally led congregations with Bible-based leadership that preach the gospel and disciple believers.","/ministries#church-planting","lawrence-baptising.jpg"],
 ["Jacob’s Well clean water project","Solar-powered boreholes and purification, with a disciple ready to share the living water of John 4.","/ministries#water","water-drilling-truck.jpg"],
 ["Nuru Toto children’s home","A safe, loving home for 30 children of the light: housing, meals, healthcare, school and the Word every day.","/ministries#nuru-toto","children/children-1.jpg"],
 ["Renewed Hearts Association","Pastoral counseling and recovery for people facing addiction, divorce and hardship.","/ministries#renewed-hearts","renewed-hearts.jpg"],
 ["Hybells Christian School","Faith foundations and market-ready trades that turn poverty into dignified work.","/ministries#hybells","hybells-students.jpg"],
];
---
<Base title="Home">
<section class="hero"><Photo src="hero.jpg" alt="" class="hero-img"/><Video src="hero.mp4" poster="hero.jpg" class="hero-vid"/>
 <div class="wrap hero-in"><h1>Welcome to<br/>{site.name}</h1><hr class="rule"/>
 <p class="lede">Planting churches, drilling wells, raising children and restoring lives across Kenya.</p>
 <div class="btns"><a class="btn ghost" href="/beliefs">What we believe</a><a class="btn ghost" href="/ministries">Our ministries</a></div></div></section>

<section class="visit"><div class="wrap"><h2>Visit us</h2><p class="det">{site.services}</p><p class="det"><a href={`tel:${site.phone}`}>{site.phone}</a></p></div></section>

<section class="gallery" aria-label="Life at BBCC"><Photo src="gallery/worship.jpg" alt="Kenyan congregation worshipping together"/><Photo src="gallery/fellowship.jpg" alt="Kenyan church members greeting each other after the service"/><Photo src="gallery/community.jpg" alt="Kenyan community members gathered at a BBCC outreach"/></section>

<section class="wrap intro"><h2>Our church runs on five pillars of evangelism.</h2></section>

<section class="wrap pillars">{pillars.map(([t,d,h,img],i)=>(
 <a href={h} class:list={["pillar",{flip:i%2}]}>
  <div class="ptext"><h3>{t}</h3><p>{d}</p><span class="more">Learn more</span></div>
  {img ? <Photo src={img} alt={t} class="pimg"/> : <div class="pimg solid"></div>}
 </a>))}</section>

<section class="band"><div class="wrap bandin"><div><h2>Bring clean water to a community with no well.</h2><p>Every borehole is a place to share the living water of Christ.</p></div><a class="btn light" href="/give#water">Give to Jacob’s Well</a></div></section>

<section class="wrap split"><div><h2>Get connected</h2><p>We’d love to hear from you. Send a message and we’ll reply.</p><p class="big"><a href={`tel:${site.phone}`}>{site.phone}</a></p></div><ContactForm/></section>
</Base>
