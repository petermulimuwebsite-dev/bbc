---
import Base from "../layouts/Base.astro"; import Photo from "../components/Photo.astro"; import ContactForm from "../components/ContactForm.astro"; import { hasImg } from "../img"; import { site, books, bookInfo } from "../config";
const pillars = [
 ["Church planting and evangelism","Vibrant, locally led congregations with Bible-based leadership that preach the gospel and disciple believers.","/ministries#church-planting","Lawrance performing Baptist.jpg","50% 40%"],
 ["Jacob’s Well clean water project","Solar-powered boreholes and purification, with a disciple ready to share the living water of John 4.","/ministries#water","water drilling.jpg","50% 50%"],
 ["Nuru Toto children’s home","A safe, loving home for 30 children of the light: housing, meals, healthcare, school and the Word every day.","/ministries#nuru-toto","children 1.jpg","50% 50%"],
 ["Renewed Hearts Association","Pastoral counseling and recovery for people facing addiction, divorce and hardship.","/ministries#renewed-hearts","",""],
 ["Hybells Christian School","A technical school teaching market-ready skills such as welding, masonry, fashion design and video editing, with compulsory Bible courses and leadership development.","/ministries#hybells","",""],
];
---
<Base title="Home">
<section class="hero"><svg class="hero-art" viewBox="0 0 1600 900" preserveAspectRatio="xMidYMax slice" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg">
<defs>
<linearGradient id="sky" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#2b2116"/><stop offset=".4" stop-color="#574530"/><stop offset=".72" stop-color="#b0824f"/><stop offset="1" stop-color="#e8bf80"/></linearGradient>
<radialGradient id="sun" cx=".5" cy=".5" r=".5"><stop offset="0" stop-color="#fff1cf" stop-opacity=".95"/><stop offset=".35" stop-color="#f6c871" stop-opacity=".45"/><stop offset="1" stop-color="#f6c871" stop-opacity="0"/></radialGradient>
</defs>
<rect width="1600" height="900" fill="url(#sky)"/>
<g fill="#fff" opacity=".65"><circle cx="180" cy="90" r="1.6"/><circle cx="330" cy="170" r="1.2"/><circle cx="470" cy="60" r="1.5"/><circle cx="620" cy="130" r="1.1"/><circle cx="1010" cy="80" r="1.4"/><circle cx="1180" cy="150" r="1.6"/><circle cx="1340" cy="70" r="1.2"/><circle cx="1480" cy="190" r="1.5"/><circle cx="90" cy="240" r="1.1"/><circle cx="1540" cy="40" r="1.2"/></g>
<circle cx="800" cy="600" r="330" fill="url(#sun)"/>
<path d="M0 690 C220 620 420 700 640 660 S1000 610 1220 670 S1480 640 1600 660 V900 H0Z" fill="#7a5f40"/>
<path d="M0 745 C260 690 480 760 760 725 S1160 690 1380 740 S1540 730 1600 720 V900 H0Z" fill="#4a3a28"/>
<g fill="#2b2116">
<g transform="translate(250 790)"><polygon points="0,-190 28,-110 -28,-110"/><polygon points="0,-150 40,-60 -40,-60"/><polygon points="0,-100 52,0 -52,0"/></g>
<g transform="translate(340 795)"><polygon points="0,-140 22,-80 -22,-80"/><polygon points="0,-110 32,-40 -32,-40"/><polygon points="0,-70 42,0 -42,0"/></g>
<g transform="translate(1290 790)"><polygon points="0,-200 30,-115 -30,-115"/><polygon points="0,-160 42,-65 -42,-65"/><polygon points="0,-105 55,0 -55,0"/></g>
<g transform="translate(1200 795)"><polygon points="0,-130 22,-75 -22,-75"/><polygon points="0,-100 32,-35 -32,-35"/><polygon points="0,-65 42,0 -42,0"/></g>
</g>
<g fill="#2b2116">
<rect x="520" y="700" width="90" height="95"/><polygon points="508,702 565,660 622,702"/>
<rect x="990" y="700" width="90" height="95"/><polygon points="978,702 1035,660 1092,702"/>
<rect x="600" y="625" width="400" height="170"/><polygon points="582,630 800,520 1018,630"/>
<rect x="745" y="400" width="110" height="395"/><polygon points="733,404 800,250 867,404"/>
<rect x="796" y="186" width="8" height="70"/><rect x="778" y="206" width="44" height="8"/>
<rect x="735" y="396" width="130" height="10"/><rect x="735" y="560" width="130" height="6" opacity=".6"/>
</g>
<g class="glow" fill="#f6c871">
<path d="M772 470 V448 A28 28 0 0 1 828 448 V470 Z" fill="#120d08"/>
<path d="M786 470 V452 A14 14 0 0 1 814 452 V470 Z"/>
<circle cx="800" cy="535" r="17"/>
<path d="M776 790 V735 A24 24 0 0 1 824 735 V790 Z"/>
<path d="M630 735 V700 A15 15 0 0 1 660 700 V735 Z"/><path d="M690 735 V700 A15 15 0 0 1 720 700 V735 Z"/>
<path d="M880 735 V700 A15 15 0 0 1 910 700 V735 Z"/><path d="M940 735 V700 A15 15 0 0 1 970 700 V735 Z"/>
<path d="M550 765 V735 A12 12 0 0 1 574 735 V765 Z"/><path d="M1026 765 V735 A12 12 0 0 1 1050 735 V765 Z"/>
</g>
<g stroke="#2b2116" stroke-width="2.5"><line x1="800" y1="518" x2="800" y2="552"/><line x1="783" y1="535" x2="817" y2="535"/><line x1="800" y1="735" x2="800" y2="790"/></g>
<path d="M0 800 C300 765 600 790 800 788 C1000 790 1300 760 1600 800 V900 H0Z" fill="#1d160e"/>
<polygon points="772,790 828,790 930,900 670,900" fill="#3b2e1f"/>
<g fill="none" stroke="#2b2116" stroke-width="3" stroke-linecap="round" opacity=".8"><path d="M1020 330 q10 -9 20 0 q10 -9 20 0"/><path d="M1090 280 q8 -7 16 0 q8 -7 16 0"/><path d="M560 300 q8 -7 16 0 q8 -7 16 0"/></g>
</svg>
 <div class="wrap hero-in"><h1>Welcome to<br/>{site.name}</h1><hr class="rule"/>
 <p class="lede">Planting churches, drilling wells, raising children and restoring lives around the world.</p>
 <div class="btns"><a class="btn ghost" href="/beliefs">What we believe</a><a class="btn ghost" href="/ministries">Our ministries</a></div></div></section>

<section class="visit"><div class="wrap"><h2>Visit us</h2><p class="det">{site.services}</p><p class="det"><a href={`tel:${site.phone}`}>{site.phone}</a></p></div></section>

<section class="gallery" aria-label="Life at BBCC"><Photo src="church.jpg" alt="The congregation gathered for a service"/><Photo src="Church meal.jpg" alt="Church members sharing a meal together"/><Photo src="church picture.jpg" alt="Members and children outside the BBCC church building"/></section>

<section class="wrap intro"><h2>Our church runs on five pillars of evangelism.</h2></section>

<section class="wrap pillars">{pillars.map(([t,d,h,img,pos],i)=>{const pic=hasImg(img);return (
 <a href={h} class:list={["pillar",{flip:pic&&i%2==1,noimg:!pic}]}>
  <div class="ptext"><h3>{t}</h3><p>{d}</p><span class="more">Learn more</span></div>
  {pic && <Photo src={img} alt={t} class="pimg" pos={pos}/>}
 </a>)})}</section>

<section class="band"><div class="wrap bandin"><div><h2>Bring clean water to a community with no well.</h2><p>Every borehole is a place to share the living water of Christ.</p></div><a class="btn light" href="/give#water">Give to Jacob’s Well</a></div></section>

<section id="books" class="wrap books"><h2>Books by {bookInfo.author}</h2>
<p class="bk-lede">Both books are available as softcopy (PDF / eBook) at {bookInfo.price} each. Pay by M-Pesa and receive your copy by email.</p>
<div class="bk-grid">{books.map(b=>(<article class="bk"><div class="bk-cover" style={`background:${b.cover}`}><span class="bk-price">{bookInfo.price}</span><span class="bk-cat">{b.cat}</span><h3>{b.title}</h3><p class="bk-sub">{b.sub}</p><p class="bk-au">{bookInfo.author}</p></div>
<div class="bk-body"><span class="tag">{bookInfo.format}</span><p>{b.desc}</p><div class="bk-btns"><a class="btn" href="/give#books">Buy softcopy</a><a class="btn line" href={`mailto:${bookInfo.email}?subject=${encodeURIComponent("Book order: "+b.title)}`}>Email to order</a></div></div></article>))}</div></section>

<section class="wrap split"><div><h2>Get connected</h2><p>We’d love to hear from you. Send a message and we’ll reply.</p><p class="big"><a href={`tel:${site.phone}`}>{site.phone}</a></p></div><ContactForm/></section>
</Base>
